{
  "name": "baiyujing-ningying",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "JadeFold · 白玉京系列凝影阁本地视频压缩工具",
  "repository": { "type": "git", "url": "https://github.com/TianSamsara/JadeFold.git" },
  "homepage": "https://github.com/TianSamsara/JadeFold#readme",
  "bugs": { "url": "https://github.com/TianSamsara/JadeFold/issues" },
  "author": "白玉京",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "node --test tests/engine.test.cjs tests/queue.test.cjs",
    "test:desktop": "node scripts/smoke.cjs",
    "test:mixed": "node scripts/mixed-smoke.cjs",
    "dist": "pnpm build && electron-builder --win portable"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12",
    "playwright": "^1.58.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "studio.baiyujing.ningying",
    "productName": "白玉京·凝影阁",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "assets/icon.png", "docs/THIRD_PARTY.md", "package.json", "!node_modules/ffprobe-static/bin/darwin/**/*", "!node_modules/ffprobe-static/bin/linux/**/*", "!node_modules/ffprobe-static/bin/win32/ia32/**/*"],
    "asarUnpack": ["node_modules/ffmpeg-static/**/*", "node_modules/ffprobe-static/**/*"],
    "win": { "target": "portable", "icon": "assets/icon.ico", "signExecutable": false },
    "artifactName": "白玉京-凝影阁-${version}-Windows.${ext}"
  }
}
